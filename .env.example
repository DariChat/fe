# 이 파일을 .env.local 로 복사해서 사용하세요.

# 백엔드 오리진. next.config.ts 의 rewrites 프록시 대상이자 WebSocket 접속 대상.
# 배포 서버: https://api.darichat.p-e.kr / 로컬 백엔드: http://localhost:8080
# (구 주소 http://52.78.23.95 는 https 로 301 리다이렉트되므로 쓰지 말 것 —
#  리다이렉트를 타면 POST 가 GET 으로 바뀌고 ws:// 핸드셰이크도 실패한다)
NEXT_PUBLIC_API_ORIGIN=https://api.darichat.p-e.kr

# axios baseURL. 비워두면 same-origin 으로 요청해 rewrites 프록시를 탄다.
# (백엔드 CORS 허용 오리진에 프론트 주소가 없어도 REST 호출이 동작한다)
NEXT_PUBLIC_API_BASE_URL=

# true = 백엔드 없이 mock 데이터로만 동작. 백엔드 붙일 때 false.
NEXT_PUBLIC_USE_MOCK=false
